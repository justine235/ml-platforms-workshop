AZURE_AI_PROJECT_ENDPOINT=https://<project>.services.ai.azure.com/api/projects/<project-name>
AZURE_OPENAI_MODEL_DEPLOYMENT=<chat-model-deployment-name>
FLEET_RECON_AGENT_NAME=fleet-recon-agent
# Fully qualified resource ID of the project connection (new-style Foundry project). UNVERIFIED against a real project. Portal: tool configuration. Python: project_client.connections.get("<connection-name>").id
FABRIC_IQ_PROJECT_CONNECTION_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<foundry-account>/projects/<foundry-project>/connections/<fabric-iq-connection>
FABRIC_WORKSPACE_ID=<fabric-workspace-guid>
FABRIC_DATA_AGENT_ID=<published-data-agent-guid>
FABRIC_IQ_SERVER_URL=
LEGACY_FABRIC_CONNECTION_ID=
LAKEHOUSE_SQL_SERVER=<workspace-guid>.datawarehouse.fabric.microsoft.com
LAKEHOUSE_SQL_DATABASE=<sql-endpoint-name>
SQL_MAX_ROWS=200
APPLICATIONINSIGHTS_CONNECTION_STRING=
